POSTGRES_USER=livs
POSTGRES_PASSWORD=change_me
POSTGRES_DB=livs_bi

# --- только для продакшена (docker-compose.prod.yml) ---
# домен, на который указывает A-запись DNS -> IP сервера
DOMAIN=bi.example.ru
# почта для уведомлений Let's Encrypt
ACME_EMAIL=admin@example.ru

# Для запуска CLI ВНУТРИ контейнера app host = "db".
# Для запуска с хоста (если когда-нибудь будет локальный Python 3.11+) host = "localhost".
DATABASE_URL=postgresql+psycopg2://livs:change_me@db:5432/livs_bi

# Metabase — логин админа для скриптов и view-only юзер (заполнить своими значениями)
MB_USER=admin@example.com
MB_PASSWORD=
MB_VIEWER_EMAIL=viewer@livs.local
MB_VIEWER_PASS=
